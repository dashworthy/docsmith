{
  "name": "@docsmith/builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React + native-Tailwind document builder — renders hand-written JSX docs to standalone HTML and to PDF (via headless Chrome print).",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "css": "tailwindcss -i src/styles/input.css -o dist/tailwind.css"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "puppeteer": "^24.15.0",
    "shiki": "^1.0.0",
    "mermaid": "^11.0.0",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsx": "^4.16.0",
    "vitest": "^2.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/node": "^20.14.0"
  }
}
