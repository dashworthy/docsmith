{
  "name": "@docsmith/docsmith",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "React document builder \u2014 renders hand-written JSX docs to PDF via @react-pdf/renderer, styled to vanilla ShadCN tokens through react-pdf-tailwind.",
  "exports": {
    ".": "./src/pdf/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gallery": "node --import tsx src/pdf/gallery.ts --open",
    "gallery:watch": "node --import tsx src/pdf/gallery.ts --watch --open"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@react-pdf/renderer": "^4.9.0",
    "mermaid": "^11.0.0",
    "puppeteer": "^24.15.0",
    "react": "^18.3.1",
    "react-pdf-tailwind": "^2.3.0",
    "shiki": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-test-renderer": "^18.3.1",
    "react-test-renderer": "^18.3.1",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
